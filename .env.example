# Copy to .env and adjust. Never commit .env.
PORT=3000
DATA_DIR=./data
# 32-byte base64 key for encrypting Up tokens. If unset, DATA_DIR/secret.key is generated on first run.
# UPKEEP_SECRET_KEY=
# IANA timezone for day/month boundaries (defaults to the server's timezone)
# TZ=Australia/Sydney
SYNC_INTERVAL_MINUTES=5
RECONCILE_HOUR=3
UP_API_BASE_URL=https://api.up.com.au/api/v1
